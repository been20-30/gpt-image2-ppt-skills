{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Design Knowledge Entity",
  "type":"object",
  "required":["id","description","applicability","constraints","recommendations","selection_signals","relationships","priority","confidence"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]*$"},
    "description":{"type":"string","minLength":1},
    "applicability":{"type":"array","items":{"type":"string"}},
    "constraints":{"type":"array","items":{"type":"string"}},
    "recommendations":{"type":"array","items":{"type":"string"}},
    "forbidden_patterns":{"type":"array","items":{"type":"string"}},
    "selection_signals":{"type":"object"},
    "relationships":{"type":"object"},
    "priority":{"type":"number","minimum":0,"maximum":1},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "data":{"type":"object"}
  },
  "additionalProperties":true
}
